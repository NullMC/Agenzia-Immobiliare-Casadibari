# Copy to .env.local for local development.
# Use only the Supabase project URL and anon/publishable key in the browser.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
VITE_SITE_URL=https://casadibari.altervista.org

# Configure these as Supabase Edge Function secrets, never in this file:
# SUPABASE_SERVICE_ROLE_KEY
# RESEND_API_KEY
# NOTIFICATION_WEBHOOK_SECRET